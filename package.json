{
  "name": "zitar-smart-planner",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs tests/*.test.ts",
    "mobile:doctor": "node scripts/android-doctor.mjs",
    "mobile:sync": "npm run build && cap sync android",
    "mobile:build:debug": "npm run mobile:sync && cd android && ./gradlew assembleDebug",
    "mobile:build:release": "npm run mobile:sync && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@phosphor-icons/react": "^2.1.7",
    "jalaali-js": "^2.0.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
